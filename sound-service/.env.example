# For running the service by hand (outside Docker): copy to .env in this folder.
# All variables are optional; defaults in src/earth_sound/bootstrap/settings.py. Docker uses the .env at the repository root instead.
ES_HOST=127.0.0.1
ES_PORT=8000
ES_LOG_LEVEL=INFO
ES_MAX_UPLOAD_MB=25
ES_MAX_IMAGE_WIDTH=1920
ES_CACHE_SIZE=8
ES_SAMPLE_RATE=22050
ES_BINS=128

# live weather (Open-Meteo, free, no key)
ES_WEATHER_GRID_STEP=10
ES_WEATHER_TTL_SEC=1800
ES_WEATHER_OFFLINE=false

# AI composer. Set one key (or both); leave both empty to use the rule-based composer only.
# Each AI composition is a paid API call. Put keys only in `.env` (git-ignored), never in this file.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ES_AI_ENABLED=true
# paid AI calls per UTC day, past it the rules compose
ES_AI_DAILY_LIMIT=100
# auto = Anthropic if its key is set, else OpenRouter; or force anthropic / openrouter
ES_AI_PROVIDER=auto
# empty = provider default: claude-opus-5-5 (Anthropic) / anthropic/claude-haiku-5.5 (OpenRouter)
ES_AI_MODEL=
ES_AI_EFFORT=low
ES_AI_TIMEOUT_SEC=90
