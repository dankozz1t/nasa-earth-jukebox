# Copy to .env in the repository root (docker compose reads it automatically). Every variable is optional.

# Host ports (bound to 127.0.0.1)
FRONTEND_PORT=5180
BACKEND_PORT=8080
# A second copy next to the first: give it its own project name and free ports
# COMPOSE_PROJECT_NAME=earth-jukebox-2

# AI composer for live weather. Leave both keys empty and the rule-based composer plays.
# Set one of them to turn AI on. Each AI composition is a paid API call.
# Use your own key, never commit it, and set a spend cap on it at the provider.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# auto = Anthropic if its key is set, otherwise OpenRouter
ES_AI_PROVIDER=auto
# empty = provider default (claude-opus-5-5 on Anthropic, anthropic/claude-haiku-5.5 on OpenRouter)
ES_AI_MODEL=
ES_AI_EFFORT=low
# Spend guards: paid AI calls per UTC day for the whole server, and per visitor per hour.
# Past either limit the rule-based composer plays and the response carries a warning.
ES_AI_DAILY_LIMIT=100
AI_PER_VISITOR_HOUR=10

# true = play the bundled weather snapshot, no internet calls to Open-Meteo
ES_WEATHER_OFFLINE=false

ES_LOG_LEVEL=INFO
# soundscapes kept in memory
ES_CACHE_SIZE=8
