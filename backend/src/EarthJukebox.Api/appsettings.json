{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SoundService": {
    "BaseUrl": "http://127.0.0.1:8000/",
    "ComposeTimeoutSeconds": 120
  },
  "Frames": {
    "Directory": "Data/frames"
  },
  "Uploads": {
    "MaxMegabytes": 25
  },
  "RateLimit": {
    "ComposePerMinute": 60,
    "AiComposePerHour": 10
  }
}
